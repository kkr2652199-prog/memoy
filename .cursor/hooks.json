{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "python .cursor/hooks/guard_boot.py"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python .cursor/hooks/guard_paths.py"
      }
    ],
    "stop": [
      {
        "command": "python .cursor/hooks/check_finish.py",
        "loop_limit": 3
      }
    ]
  }
}
